# LazyMC's public Java listener. Geyser connects here so Bedrock logins
# go through the same wake-on-connect path as Java clients.
LAZYMC_ADDRESS=host.docker.internal
LAZYMC_PORT=25565

# Host port exposing the actual Fabric server behind LazyMC.
# Point LazyMC's backend/server address at 127.0.0.1:25566.
MC_BACKEND_PORT=25566
